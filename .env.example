PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/adedoyin
SESSION_SECRET=change-me-to-a-long-random-string
# First admin (created by the seed script). If omitted a random password is printed once.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Optional: email delivery for contact form (Gmail app password or any SMTP)
MAIL_USER=
MAIL_PASS=
# Set to 1 when behind HTTPS proxy in production
SECURE_COOKIES=0
